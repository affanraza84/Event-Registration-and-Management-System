# ==============================================================================
# EventScout — Environment Configuration Template
# Live Event Discovery & Management Platform
# ==============================================================================
# Instructions:
# 1. Copy this file to .env.local: cp .env.example .env.local
# 2. Fill in the placeholder values below with your credentials.
# 3. DO NOT commit .env.local to version control.
# ==============================================================================

# MongoDB Configuration
# MongoDB Atlas or local connection URI (e.g., mongodb://127.0.0.1:27017/eventscout)
MONGODB_URI=your_mongodb_connection_string

# NextAuth Configuration
# A secure 32+ character random string for signing JWT session tokens.
# Generate on macOS/Linux via: openssl rand -base64 32
NEXTAUTH_SECRET=your_nextauth_secret_key

# Canonical base URL of the application (e.g. http://localhost:3000 in dev, or your production domain)
NEXTAUTH_URL=http://localhost:3000

# SerpApi Configuration (Server-Side Only)
# Private API key from https://serpapi.com/dashboard
# WARNING: NEVER prefix this variable with NEXT_PUBLIC_ or commit it publicly.
SERPAPI_API_KEY=your_serpapi_api_key_here

# Cloudinary Configuration (Server-Side Only)
# API credentials from https://console.cloudinary.com/
# Note: Ensure your Access Key in Cloudinary Settings > Access Keys has "create" (or Full Access) permissions.
# WARNING: NEVER prefix CLOUDINARY_API_SECRET with NEXT_PUBLIC_ or expose it in client code.
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
# Optional upload preset name if using upload presets
# CLOUDINARY_UPLOAD_PRESET=your_upload_preset
# Optional upload folder (defaults to eventscout/events)
CLOUDINARY_FOLDER=eventscout/events
# Optional max file size in bytes (defaults to 5242880 = 5MB)
MAX_IMAGE_FILE_SIZE_BYTES=5242880


